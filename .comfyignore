# Kept out of the published registry archive. Same syntax as .gitignore.
#
# Everything here is development machinery: useful in the repository, dead weight
# in the zip that users download. The docs and the example workflows stay in, since
# those are the things people actually need.

tests/
.github/
__pycache__/
*.pyc

# the README screenshots: needed on GitHub, dead weight in a download
images/

# personal-only modules and credentials: never in a published archive, however it is built
local/
nai_token.txt
**/nai_token.txt
user_data/
